{
  "type": "system-design",
  "title": "Encoding and Evolution: A Rolling Deployment",
  "maxLatencyMs": 200,
  "simulation": {
    "palette": ["client", "loadBalancer", "server", "database", "schemaRegistry"],
    "traffic": {
      "requests": 2000,
      "duration_ms": 2000,
      "mix": { "read": 70, "write": 30 },
      "client_versions": { "v1": 1, "v2": 1 }
