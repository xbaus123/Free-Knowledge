    "rollout": { "to": "v2", "start_ms": 300, "interval_ms": 500, "restart_ms": 300 },
    "schema": {
      "v1": [
        { "tag": 1, "name": "user_id", "type": "int64", "required": true },
        { "tag": 2, "name": "email", "type": "string", "required": true },
        { "tag": 3, "name": "nickname", "type": "string" }
      ],
      "new_fields": ["phone", "referral_code"]
    }
  }
}
