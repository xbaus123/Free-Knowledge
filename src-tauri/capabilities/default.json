{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "claude://claude.ai/new?q=*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
